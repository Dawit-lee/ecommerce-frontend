{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://Ecom-app-env.eba-npaqhkee.ap-northeast-2.elasticbeanstalk.com/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "http://Ecom-app-env.eba-npaqhkee.ap-northeast-2.elasticbeanstalk.com/images/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
